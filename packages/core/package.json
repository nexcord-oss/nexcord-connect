    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.80.6",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "viem": "^2.30.6",
    "wagmi": "^2.15.6"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "connectkit": "^1.9.2"
  }
